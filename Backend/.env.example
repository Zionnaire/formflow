# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ─────────────────────────────────────────────────────────────
# "memory" spins up a throwaway in-process MongoDB automatically (zero setup, nothing
# persists across restarts). Swap in an Atlas or local mongod URI once you need data to stick:
#   MONGODB_URI=mongodb://127.0.0.1:27017/formflow_dev
MONGODB_URI=memory

# ── Auth ────────────────────────────────────────────────────────────────
# 32+ byte random string — used to sign JWT access/refresh tokens (HS256)
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# ── Cloudinary (profile photos, signatures, source PDFs) ───────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Groq (field extraction, auto-fill mapping) ─────────────────────────
# Check https://console.groq.com/docs/models before changing GROQ_MODEL — Groq
# deprecates/rotates models often; confirm the id is active first.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── CORS — comma-separated allowed origins ─────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Shared-fill links ───────────────────────────────────────────────────
SHARE_TOKEN_TTL_DAYS=14
FRONTEND_URL=http://localhost:3000

# ── Email (sending the finished PDF — Services/email.service.ts) ──────
# Absent by default — the feature 503s cleanly rather than failing confusingly. Any SMTP
# provider works (Gmail app password, SendGrid/Mailgun/Postmark SMTP, your own mail server).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FormFlow <no-reply@yourdomain.com>

