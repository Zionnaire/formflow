# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── MongoDB ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/formflow_dev

# ── Auth ────────────────────────────────────────────────────────────────
# 32+ byte random string — used to sign JWT access/refresh tokens (HS256)
JWT_SECRET=replace-with-a-long-random-string
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# ── Cloudinary (profile photos, signatures, source PDFs) ───────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Claude API (field extraction, auto-fill mapping, validation) ───────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ── CORS — comma-separated allowed origins ─────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000

# ── Shared-fill links ───────────────────────────────────────────────────
SHARE_TOKEN_TTL_DAYS=14
FRONTEND_URL=http://localhost:3000
